{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run typecheck && npm test && npm run build",
  "framework": null,
  "regions": [
    "dub1"
  ],
  "rewrites": [
    {
      "source": "/aimg/:token",
      "destination": "/api/og"
    },
    {
      "source": "/og/:file",
      "destination": "/api/og"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/cron/digest",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/og.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/static/:file(.*\\.(?:css|js))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}